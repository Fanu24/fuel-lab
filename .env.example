# Numero WhatsApp di destinazione, con prefisso internazionale.
# Senza questa variabile i bottoni restano disabilitati invece di produrre link rotti.
NEXT_PUBLIC_WHATSAPP=393404547019

# Segreti server Cloudflare Pages (impostare con `wrangler pages secret put`).
# BETTER_AUTH_SECRET deve essere casuale e lungo almeno 32 caratteri.
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=  # chiave Resend Sending access limitata a fuelchef.it
# Senza RESEND_API_KEY le email (accesso e avvisi) vengono saltate e annotate nei log, senza errori.
# ADMIN_NOTIFY_EMAIL=info@fuelchef.it  # dove arrivano nuove richieste, annullamenti e messaggi del modulo contatti
# Apple richiede un account Apple Developer e credenziali Sign in with Apple.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# Notifiche push a Matteo per ogni ordine dal sito (Web Push). Le chiavi si generano con `node scripts/genera-vapid.mjs`.
# Senza queste tre variabili le notifiche push restano spente, il resto del sito non cambia.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@fuelchef.it

# Verifica del sito su Google Search Console e Bing Webmaster Tools (metodo "tag HTML"):
# incolla solo il valore di content="…". Sono variabili di build: dopo averle impostate, ripubblica.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
