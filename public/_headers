# Header per Cloudflare (Workers static assets e Pages leggono entrambi questo file).

# I file di _next/static hanno l'hash nel nome: cambiano nome quando cambiano,
# quindi possono restare in cache per sempre.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/foto/*
  Cache-Control: public, max-age=604800

# Sicurezza di base su tutte le pagine.
# HSTS senza includeSubDomains: i sottodomini (posta, anteprime) restano liberi.
# Niente Content-Security-Policy: l'export statico usa script inline (tema,
# dati di Next) che una CSP senza nonce bloccherebbe.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Le pagine private non vanno indicizzate (c'e' gia' il meta robots, questo e'
# il rinforzo, e vale anche per le varianti .html e i payload dell'export).
# Sono file statici dell'export: per questo qui bastano i loro percorsi.
/dashboard
  X-Robots-Tag: noindex, nofollow

/dashboard/*
  X-Robots-Tag: noindex, nofollow

/admin*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/account*
  X-Robots-Tag: noindex

/accedi*
  X-Robots-Tag: noindex

/reimposta-password*
  X-Robots-Tag: noindex

# Le API (/api/*) non stanno qui: _headers vale solo per i file statici, non per
# le Pages Functions. Noindex, nosniff e no-store li imposta
# functions/api/_middleware.ts, e robots.txt tiene fuori /api/.

# I manifest delle app installabili (sito e pannello), con il tipo giusto.
/manifest.webmanifest
  Content-Type: application/manifest+json

/pannello.webmanifest
  Content-Type: application/manifest+json

# I domini tecnici ospitano copie del sito, non risultati di ricerca.
https://fuelchef.pages.dev/*
  X-Robots-Tag: noindex

https://:version.fuelchef.pages.dev/*
  X-Robots-Tag: noindex

