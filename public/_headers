# Header per Cloudflare (Workers static assets e Pages leggono entrambi questo file).

# I file di _next/static hanno l'hash nel nome: cambiano nome quando cambiano,
# quindi possono restare in cache per sempre.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Sicurezza di base su tutte le pagine.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Il pannello non va indicizzato (c'e' gia' il meta robots, questo e' il rinforzo).
/dashboard
  X-Robots-Tag: noindex, nofollow

/dashboard/*
  X-Robots-Tag: noindex, nofollow
